# This is an example environment file for Picacho. Copy this file to .env and fill in the required values.

# Google OAuth 2.0 credentials for Picacho. You can obtain these from the Google Cloud Console.
PICACHO_GOOGLE_CLIENT_ID="123456789-abcdefghijklmnopqrstuvwxyz.apps.googleusercontent.com"
PICACHO_GOOGLE_CLIENT_SECRET="ABC-aBcDeFgH-aBcDeFghIjkLmnOpQrStUvWxYz"

# Microsoft OAuth 2.0 credentials for Picacho. You can obtain these from the Entra portal (formerly Azure portal).
PICACHO_MICROSOFT_CLIENT_ID="12345678-1234-1234-1234-123456789abc"

# Fastmail OAuth 2.0 client for Picacho (JMAP), registered with Fastmail. Without it, Fastmail asks for an API token.
# PICACHO_FASTMAIL_CLIENT_ID="..."

# The following variables are used for Proton Mail Bridge integration. You can obtain the app token and version from the official Proton Mail Bridge releases page.
# Proton app name token
PICACHO_PROTON_APP_TOKEN="bridge"
# Latest version of Proton Mail Bridge: https://github.com/ProtonMail/proton-bridge/releases 
PICACHO_PROTON_APP_VERSION="3.27.2"
# PICACHO_PROTON_APP_PLATFORM_OVERRIDE="linux" # Uncomment to override the platform for Proton Mail Bridge (e.g., "windows", "macos", "linux")
# Registering for push notifications alone can name its own token, version and
# platform; each one left out is the one above.
# PICACHO_PROTON_PUSH_APP_TOKEN=""
# PICACHO_PROTON_PUSH_APP_VERSION=""
# PICACHO_PROTON_PUSH_APP_PLATFORM=""


# Proton Pass, where Proton keeps its own (hide-my-email) aliases, signs in on
# its own as the app registration named here: Proton gives Pass access only to
# a session signed in as an app with Pass (a fork of the mail session doesn't
# gain it). With a token or version set, adding Proton in Settings ->
# Forwarding signs in to Pass as signing in to Proton Mail does (password, then
# second factor) and keeps that session in the keychain. Each one left out is the one above. With
# neither, Pass's requests use the account's own session.
PICACHO_PROTON_PASS_APP_TOKEN="pass"
PICACHO_PROTON_PASS_APP_VERSION="1.44.0"
PICACHO_PROTON_PASS_APP_PLATFORM="web"
