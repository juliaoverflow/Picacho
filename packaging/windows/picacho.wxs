<!--
  Picacho's Windows installer (an MSI), built by scripts/bundle-windows.ps1
  with the WiX Toolset 5 .NET tool (`wix build`). It installs for the
  current user alone, without administrator rights, into
  %LOCALAPPDATA%\Programs\Picacho, with a Start menu shortcut carrying
  Picacho's AppUserModelID (src/display/windows.rs), so its notifications
  and taskbar button are Picacho's. Upgrades replace the earlier version.

  Variables (-d on the command line):
    Version         the MSI's version, major.minor.patch (Cargo.toml's)
    ExeDir          the folder with picacho.exe and, for GNU builds,
                    WebView2Loader.dll (MSVC builds link it in)
    WebView2Loader  "yes" to install WebView2Loader.dll
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Picacho"
           Language="1033"
           Version="$(var.Version)"
           Manufacturer="Pinal Tech"
           UpgradeCode="6B7F5D0E-3C1A-4E8B-9A2F-5D4C3B2A1908"
           Scope="perUser">
    <SummaryInformation Description="Picacho email" />

    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of Picacho is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="PicachoIcon" SourceFile="$(var.ExeDir)\picacho.exe" />
    <Property Id="ARPPRODUCTICON" Value="PicachoIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/pinaltech/Picacho" />

    <!-- Dialogs (WixToolset.UI.wixext): welcome with the license, progress,
         and a finish page offering to open Picacho. Without them the MSI
         installs with no more than a brief "Configuring" box. -->
    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="$(sys.SOURCEFILEDIR)license.rtf" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Open Picacho" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="OpenPicacho"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
    </UI>
    <!-- Runs the installed picacho.exe without waiting for it. -->
    <CustomAction Id="OpenPicacho" FileRef="PicachoExeFile" ExeCommand="" Return="asyncNoWait" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLDIR" Name="Picacho" />
      </Directory>
    </StandardDirectory>

    <DirectoryRef Id="INSTALLDIR">
      <Component Id="PicachoExe" Guid="3E2B6A0C-8D41-4F57-B1C9-0A6E2F4D7B13">
        <File Id="PicachoExeFile" Source="$(var.ExeDir)\picacho.exe" KeyPath="no" />
        <!-- Per-user components keep their key path in the registry. -->
        <RegistryValue Root="HKCU" Key="Software\Pinal Tech\Picacho"
                       Name="InstallDir" Type="string" Value="[INSTALLDIR]" KeyPath="yes" />
        <RemoveFolder Id="RemoveInstallDir" On="uninstall" />
        <RemoveFolder Id="RemoveProgramsFolder" Directory="ProgramsFolder" On="uninstall" />
      </Component>
      <?if $(var.WebView2Loader) = "yes" ?>
      <Component Id="WebView2Loader" Guid="9C4D2E1F-7A35-4B68-8E0D-3F1A6C5B2E47">
        <File Id="WebView2LoaderFile" Source="$(var.ExeDir)\WebView2Loader.dll" KeyPath="no" />
        <RegistryValue Root="HKCU" Key="Software\Pinal Tech\Picacho"
                       Name="WebView2Loader" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <?endif?>
    </DirectoryRef>

    <!-- Picacho in Windows' Default apps: the mailto: protocol, .eml and
         Outlook .msg files (Capabilities registered under RegisteredApplications),
         so it can be chosen as the email app directly from Picacho's Settings
         or Windows Default apps. -->
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="DefaultApp" Guid="B2E7C4A1-6D38-4F95-8C0B-1A9E3D5F7C26">
        <RegistryValue Root="HKCU" Key="Software\Classes\Picacho.mailto" Value="URL:MailTo Protocol" Type="string" KeyPath="yes" />
        <RegistryValue Root="HKCU" Key="Software\Classes\Picacho.mailto" Name="URL Protocol" Value="" Type="string" />
        <RegistryValue Root="HKCU" Key="Software\Classes\Picacho.mailto\DefaultIcon" Value="[INSTALLDIR]picacho.exe,0" Type="string" />
        <RegistryValue Root="HKCU" Key="Software\Classes\Picacho.mailto\shell\open\command" Value="&quot;[INSTALLDIR]picacho.exe&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKCU" Key="Software\Classes\picacho" Value="URL:Picacho Protocol" Type="string" />
        <RegistryValue Root="HKCU" Key="Software\Classes\picacho" Name="URL Protocol" Value="" Type="string" />
        <RegistryValue Root="HKCU" Key="Software\Classes\picacho\DefaultIcon" Value="[INSTALLDIR]picacho.exe,0" Type="string" />
        <RegistryValue Root="HKCU" Key="Software\Classes\picacho\shell\open\command" Value="&quot;[INSTALLDIR]picacho.exe&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKCU" Key="Software\Classes\Picacho.eml" Value="Email Message" Type="string" />
        <RegistryValue Root="HKCU" Key="Software\Classes\Picacho.eml\DefaultIcon" Value="[INSTALLDIR]picacho.exe,0" Type="string" />
        <RegistryValue Root="HKCU" Key="Software\Classes\Picacho.eml\shell\open\command" Value="&quot;[INSTALLDIR]picacho.exe&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKCU" Key="Software\Classes\.eml\OpenWithProgids" Name="Picacho.eml" Value="" Type="string" />
        <RegistryValue Root="HKCU" Key="Software\Classes\Picacho.msg" Value="Outlook Email Message" Type="string" />
        <RegistryValue Root="HKCU" Key="Software\Classes\Picacho.msg\DefaultIcon" Value="[INSTALLDIR]picacho.exe,0" Type="string" />
        <RegistryValue Root="HKCU" Key="Software\Classes\Picacho.msg\shell\open\command" Value="&quot;[INSTALLDIR]picacho.exe&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKCU" Key="Software\Classes\.msg\OpenWithProgids" Name="Picacho.msg" Value="" Type="string" />
        <RegistryValue Root="HKCU" Key="Software\Pinal Tech\Picacho\Capabilities" Name="ApplicationName" Value="Picacho" Type="string" />
        <RegistryValue Root="HKCU" Key="Software\Pinal Tech\Picacho\Capabilities" Name="ApplicationDescription" Value="Fast, native email for every inbox you have" Type="string" />
        <RegistryValue Root="HKCU" Key="Software\Pinal Tech\Picacho\Capabilities\URLAssociations" Name="mailto" Value="Picacho.mailto" Type="string" />
        <RegistryValue Root="HKCU" Key="Software\Pinal Tech\Picacho\Capabilities\FileAssociations" Name=".eml" Value="Picacho.eml" Type="string" />
        <RegistryValue Root="HKCU" Key="Software\Pinal Tech\Picacho\Capabilities\FileAssociations" Name=".msg" Value="Picacho.msg" Type="string" />
        <RegistryValue Root="HKCU" Key="Software\Clients\Mail\Picacho" Value="Picacho" Type="string" />
        <RegistryValue Root="HKCU" Key="Software\Clients\Mail\Picacho\Capabilities" Name="ApplicationName" Value="Picacho" Type="string" />
        <RegistryValue Root="HKCU" Key="Software\RegisteredApplications" Name="Picacho" Value="Software\Pinal Tech\Picacho\Capabilities" Type="string" />
      </Component>
    </DirectoryRef>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="5A1E3C7B-2F94-4D06-A8B3-6E0C9D2F1A84">
        <Shortcut Id="PicachoShortcut"
                  Name="Picacho"
                  Description="Email"
                  Target="[INSTALLDIR]picacho.exe"
                  WorkingDirectory="INSTALLDIR"
                  Icon="PicachoIcon">
          <!-- System.AppUserModel.ID: tech.pinal.picacho -->
          <ShortcutProperty Key="{9F4C2855-9F79-4B39-A8D0-E1D42DE1D5F3}, 5"
                            Value="tech.pinal.picacho" />
        </Shortcut>
        <RegistryValue Root="HKCU" Key="Software\Pinal Tech\Picacho"
                       Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Picacho" Title="Picacho" Level="1">
      <ComponentRef Id="PicachoExe" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DefaultApp" />
      <?if $(var.WebView2Loader) = "yes" ?>
      <ComponentRef Id="WebView2Loader" />
      <?endif?>
    </Feature>
  </Package>
</Wix>
