# Text from the Android and iOS glue (src/android, src/ios), mostly
# errors, and from the app's start (src/main.rs).

android-keys-security-keys-cant-be-used-on = Security keys can't be used on this phone.

android-keys-sign-in-cancelled = Sign-in cancelled.

android-keys-picacho-wasnt-allowed-to-use-the = Picacho wasn't allowed to use the security key. Plug it in again, and allow Picacho to use it.

android-keys-passkeys-cant-be-used-on-this = Passkeys can't be used on this phone.

android-keys-using-a-passkey-was-cancelled = Using a passkey was cancelled.

android-keys-open-picacho-to-use-a-passkey = Open Picacho to use a passkey.

android-keys-no-passkey-for-this-proton-account = No passkey for this Proton account was found. Use another way, or the code from your authenticator app.

android-keys-passkeys-need-android-14-or-later = Passkeys need Android 14 or later here. Use a security key, or the code from your authenticator app.

android-keys-your-password-manager-didnt-let-picacho = Your password manager didn't let Picacho use your Proton passkey: it only lets browsers it knows ask for another site's passkeys. Use a security key, or the code from your authenticator app.

android-keys-the-passkey-didnt-work = The passkey didn't work.

android-keys-the-passkey-didnt-work-2 = The passkey didn't work ({ $detail }).

android-keys-the-passkeys-answer-couldnt-be-read = The passkey's answer couldn't be read.

android-keys-the-passkeys-answer-was-incomplete = The passkey's answer was incomplete.

android-saving-isnt-available-yet = Saving isn't available yet

android-couldnt-save-the-file = Couldn't save the file

android-could-not-open-the-browser = Could not open the browser

android-proton-wants-to-check-that-its = Proton wants to check that it's you, but its check couldn't be shown.

android-sign-in-cancelled = Sign-in cancelled.

# The title of Android's fingerprint or face prompt
android-unlock-picacho = Unlock Picacho

# The button in Android's fingerprint or face prompt that asks for the app's passcode instead
android-use-passcode = Use Passcode

android-the-fingerprint-or-face-prompt-couldnt = The fingerprint or face prompt couldn't be shown.

android-this-phones-android-is-too-old = This phone's Android is too old for fingerprint or face unlock.

ios-keys-this-device-cant-read-security-keys = This device can't read security keys: it has no NFC. Use a passkey on another device, or the code from your authenticator app.

# On iOS's NFC sheet, when something that isn't a security key is held to the iPhone
ios-keys-that-isnt-a-security-key = That isn't a security key. Hold your security key near the top of your iPhone.

# On iOS's NFC sheet, when the security key moved away before it could be read
ios-keys-hold-your-security-key-still = Hold your security key still, near the top of your iPhone.

ios-keys-sign-in-cancelled = Sign-in cancelled.

ios-keys-no-security-key-was-found-hold = No security key was found. Hold it flat against the top of your iPhone, and try again.

ios-keys-using-the-security-key-was-cancelled = Using the security key was cancelled.

ios-proton-wants-to-check-that-its = Proton wants to check that it's you, but its check couldn't be shown.

# The title of the screen where Proton checks that it's you (a CAPTCHA)
ios-verify-that-its-you = Verify that it's you

ios-sign-in-cancelled = Sign-in cancelled.

main-cannot-find-the-application-data-directory = Cannot find the application data directory

main-picacho-is-already-running-but-isnt = Picacho is already running but isn't responding. Quit it, then open Picacho again.
