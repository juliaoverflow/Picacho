# The desktop entry for app menus and launchers on Linux: the one Picacho
# writes when no package installed one (src/display/desktop.rs), and the
# Flatpak's (scripts/release/l10n.py). Each message is one line.

# What kind of app Picacho is, shown with its name in app menus
desktop-generic-name = Email Client

# A tooltip for Picacho in app menus
desktop-comment = Fast, native email for every inbox you have

# Words that find Picacho when searching app menus, each followed by a
# semicolon (;). Words people search with in your language; English ones
# can stay too.
desktop-keywords = mail;email;inbox;imap;
