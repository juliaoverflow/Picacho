# src/display/recovery.rs and nearby views.

recovery-start-over-moves-the-unreadable-database = Start Over moves the unreadable database aside, next to where it was (nothing is deleted), and opens Picacho with a new, empty one: add your accounts again, and mail on their servers downloads again. Drafts saved only on this device, and mail only this device kept (POP accounts that remove it from the server), stay in the old file.

recovery-nothing-was-changed-if-the-system = Nothing was changed. If the system keychain is locked, unlock it, or allow Picacho to use it, then try again.

recovery-quit = Quit

recovery-move-aside-and-start-over = Move Aside and Start Over

recovery-start-over = Start Over…

recovery-trying = Trying…

recovery-try-again = Try Again

recovery-picacho-couldnt-open-its-local-database = Picacho couldn't open its local database

recovery-folder = Folder: { $path }
