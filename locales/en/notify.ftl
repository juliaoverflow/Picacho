# src/display/notify.rs and nearby views.

notify-new-messages = { $count ->
        [1] New message
       *[other] { $count } new messages
    }

notify-a-snoozed-message-is-back-in = A snoozed message is back in the inbox

notify-snoozed-messages-are-back-in-the = { $count } snoozed messages are back in the inbox

notify-back-from-snooze = Back from snooze

notify-scheduled-message-sent = Scheduled message sent

notify-to = { $subject } — to { $to }

notify-a-scheduled-message-wasnt-sent = A scheduled message wasn't sent

notify-its-in-drafts = It's in Drafts.

notify-its-in-drafts-2 = { $subject }: { $error } It's in Drafts.

notify-no-subject = (No subject)

notify-upcoming-event = Upcoming event

notify-calendar = Calendar

notify-open = Open

notify-actions = Actions

# Buttons on a new message's notification.
notify-mark-as-read = Mark as Read

notify-archive = Archive

notify-delete = Delete

notify-reply = Reply

# Buttons on a notification of several new messages.
notify-mark-all-as-read = Mark All as Read

notify-archive-all = Archive All

notify-delete-all = Delete All

notify-the-account-is-gone = The account is gone
