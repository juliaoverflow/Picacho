# src/display/follow_up.rs and nearby views.

follow-up-no-reply-yet-to = No reply yet to “{ $subject }”

follow-up-messages-without-a-reply = { $count } messages you're waiting on have no reply

follow-up-replied-no-longer-waiting = { $sender } replied to “{ $subject }”

follow-up-replies-came = { $count } messages you were waiting on got replies

follow-up-no-message-id = This message has no Message-ID, so replies to it can't be recognized.

follow-up-remind-me = Remind Me

follow-up-reminds-you = If nobody replies, Picacho reminds you { $when }.

follow-up-no-longer-waiting = No longer waiting for a reply

follow-up-stop-waiting = Stop Waiting

follow-up-remind-me-again = Remind Me Again

follow-up-change-reminder = Change Reminder

follow-up-follow-up = Follow Up

follow-up-no-reply-since = No reply yet. You sent it { $sent }.

follow-up-waiting-reminds-you = Waiting for a reply. If nobody answers, Picacho reminds you { $when }.

follow-up-waiting-for = Waiting For

follow-up-waiting-for-overdue = Waiting For, { $count } without a reply

follow-up-sent-today = today

follow-up-sent-yesterday = yesterday

follow-up-sent-days-ago = { $count } days ago
