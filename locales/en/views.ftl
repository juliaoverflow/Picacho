# src/display/views.rs and nearby views.

views-another-list-was-asked-for-meanwhile = Another list was asked for meanwhile.

views-all-accounts = All Accounts

views-mail-from-every-account = Mail from every account

# A forwarding service's alias and the address it forwards to
views-alias-forwards-to = { $label } alias · forwards to { $email }

views-alias = { $label } alias

views-refresh = Refresh

views-mark-inbox-as-read = Mark Inbox as Read

views-expand = Expand

views-collapse = Collapse

views-hide-all-accounts = Hide All Accounts

views-copy-address = Copy Address

views-forwarding-settings = Forwarding Settings…

views-show-in-mailbox = Show in Mailbox

views-unread = { $count ->
       *[other] { $label } · { $shown } unread
    }

views-connected-alias = Connected { $label } · { $count ->
        [one] { $count } alias
       *[other] { $count } aliases
    }

views-use-letters-numbers-dots-dashes-or = Use letters, numbers, dots, dashes or underscores in the prefix.

views-created-copied = Created { $email } · copied

views-suggested = Suggested: { $prefix_suggestion }

views-alias-deleted = Alias deleted
